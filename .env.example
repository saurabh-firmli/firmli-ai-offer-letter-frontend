# Only VITE_* variables are exposed to the browser. Read them via src/config.ts.
VITE_SITE_NAME=Firmli AI Offer Letter
# Base url of firmli-ai-offer-letter-backend, including the api version
VITE_API_BASE_URL=http://localhost:3000/v1
# Request timeout in ms
VITE_API_TIMEOUT=30000
# DEV ONLY, TEMPORARY: tenant uuid sent as the X-Tenant-Id header until backend auth exists.
# Needs TENANT_HEADER_FALLBACK=true on the backend; production refuses it. Leave empty to not send it.
VITE_DEV_TENANT_ID=
