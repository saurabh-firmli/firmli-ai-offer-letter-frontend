{
  "name": "firmli-ai-offer-letter-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Firmli AI Offer Letter - Frontend",
  "author": "Team Firmli",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc && eslint . && prettier --check . && vitest run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/dates": "^7.17.8",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/modals": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@tabler/icons-react": "^2.47.0",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.6.7",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^20.19.10",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "@swc/core": "1.15.8"
  }
}
